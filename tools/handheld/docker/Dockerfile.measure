# Linux arm64 image used for handheld RAM measurements (phase 1A).
# Uses the distro Qt (6.9.x) on purpose: measurements only, not the device build.
FROM ubuntu:25.10
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config ca-certificates \
    qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
    qt6-tools-dev qt6-tools-dev-tools qt6-l10n-tools libqt6opengl6-dev libqt6sql6-sqlite \
    libgl-dev libegl-dev libgles-dev libgl1-mesa-dri libglx-mesa0 mesa-utils \
    libssl-dev libzstd-dev libasound2-dev x11-apps imagemagick xvfb xauth procps valgrind heaptrack \
    && rm -rf /var/lib/apt/lists/*
